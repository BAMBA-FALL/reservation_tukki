{% extends 'base.html.twig' %}

{% block title %}{{ room.titre }}{% endblock %}

{% block body %}
<div class="container ml-3 text-start">
    <a href="javascript:history.back()" class="btn btn-dark">Retour</a>
</div>
<h1>{{ room.titre }}</h1>
<div class="row">
    <div class="col-12 col-md-6"> {# Utilisez col-md-6 pour occuper la moitié de la page sur tous les écrans #}
        {# on vérifie si la chambre a des images #}
        {% if room.images|length > 0 %}
        {# on affiche la première image #}
        <a href="{{ asset('images/room/' ~ room.images[0].imageName) }}" data-lightbox="{{ room.titre }}">
            <img src="{{ asset('images/room/' ~ room.images[0].imageName) }}" alt="{{ room.titre }}" class="img-fluid" id="img-big">
        </a>
        {# on vérifie s'il y a plus d'une image dans la collection #}
        {% if room.images|length > 1 %}
        <div class="row justify-content-between">
            {% for image in room.images %}
            {% if loop.index0 > 0 %}
            <div class="col img-30 mt-3 cursor-pointer">
                <img src="{{ asset('images/room/' ~ room.images[loop.index0].imageName) }}" alt="" class="img-fluid" id="img-big">
            </div>
            {% endif %}
            {% endfor %}
        </div>
        {% endif %}
        {% endif %}
    </div>
    <div class="col-12 col-md-6"> {# La seconde moitié de la page #}
        <div>{{ room.description|raw }}</div>
        <div>Prix {{ room.prix|format_currency('EUR') }}</div>
        <a href="{{ path('app_front_reservation', {id: room.id}) }}" class="btn btn-dark">Réserver</a>
        {# <a href="{{ path('app_front_hotel', {'slug': hotel.slug }) }}" class="btn btn-dark">Voir</a> #}
    </div>
</div>
{% endblock %}

{# on récupère les objets de la classe cursor-pointer #}
{% block javascripts %}
<script>
    $('.cursor-pointer').on('click', function (e) {
        e.stopPropagation();
        // on récupère la valeur de l'attribut src de l'image cliquée
        let itemSource = $(this).find('img').attr('src')
        // on récupère la valeur de l'attribut src de la grande image
        let currentSource = $('#img-big').attr('src')
        // on remplace l'attribut src de la grande image par celui de celle cliquée et on remplace 
        // également l'attribut de l'href de la balise <a>
        $('#img-big').attr('src', itemSource);
        $('#img-big').parent().attr('href', itemSource);
        // on change le src de l'image cliquée 
        $(this).find('img').attr('src', currentSource);
    })

    {# function goBack(){
    window.history.back();
} #}
</script>
{% endblock %}
