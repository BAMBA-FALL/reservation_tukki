{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<form method="post">
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
        <div class="mb-3">
           Vous êtes connecté en tant que  {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Deconnexion</a>
        </div>
    {% endif %}

  <div class="container-formulaire">
    <div class="row justify-content-center">
        <div class="col-md-3">
            <form class="form-signin">
                <h1 class="h3 mb-3 font-weight-normal">Connexion</h1>
                <label for="inputEmail" class="mb-2">Email</label>
                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control mb-3" autocomplete="email" required autofocus>
               
               <div class="d-flex justify-content-between align-items-center mt-6">
                <label for="inputPassword" class="mb-2">Mot de passe</label>
                <a href="{{ path('app_forgot_password_request') }}" class="text-dark mb-2">Mot de passe oublié</a>
               </div>

                <input type="password" name="password" id="inputPassword" class="form-control mb-3" autocomplete="current-password" required>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            
                <button class="btn btn-lg btn-primary mt-3 mx-auto" type="submit">Se connecter</button> <!-- Ajoutez la classe mx-auto ici -->
            </form>
        </div>
    </div>
</div>


{% endblock %}
