{% extends 'base.html.twig' %}

{% block title %}Hello FrontReservationController!{% endblock %}

{% block body %}
<div class="container">
    <button onclick="goBack()" class="btn btn-dark mb-2">Retour</button>
    <div class="row">
        <div class="col-md-6">
            <div class="ml-4 shadow rounded">
                <img src="{{ asset('images/room/' ~ room.images[0].imageName) }}" alt="{{ room.titre }}" class="img-fluid hover" id="img-big">
            </div>
            <h2>{{ room.titre }}</h2>
            <div class="mt-2 desc-justify">{{ room.description|raw }}</div>
        </div>

        <div class="col-md-6">
            <div class="shadow p-3 mb-5 bg-white rounded">
     
                <div><span id="prix">{{ room.prix|format_currency('EUR') }}</span>
                
                <h3>Prix par nuit :</h3>
                </div>
                
                <h3>Total :</h3>
                <div id="total"></div>
                {{ form_start(form) }}
                {{ form_widget(form) }}
                <button type="submit" class="btn btn-dark">Réserver</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<script>
    function goBack() {
        window.history.back();
    }
</script>
{% endblock %}







