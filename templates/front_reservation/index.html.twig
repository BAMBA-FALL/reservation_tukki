{% endblock %}







{% block javascripts %}
<script>
function calculPrix(){
let dateArrivee = new Date($("#reservation_dateDebut").val());
let dateDepart = new Date($("#reservation_dateFin").val());
let currentDate = new Date();
$("#tarif")
if (dateDepart < dateArrivee) {
    alert("La date de départ ne doit pas être antérieure à la date d'arrivée");
} else {
    let ms = dateDepart - dateArrivee;
    let s = ms / 1000;
    let m = s / 60;
    let h = m / 60;
    let j = parseInt(h / 24);

    let total = $("#prix").html() * j;
    $("#total").html(total);
}

}
$("#reservation_dateDebut").on("change", function(event){

    calculPrix();
})
$("#reservation_dateFin").on("change", function(event){

    calculPrix();
});

function goBack(){
    window.history.back();
}
</script>

