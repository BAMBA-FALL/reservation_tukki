function calculPrix() {
    const dateArrivee = new Date($("#reservation_dateDebut").val());
    const dateDepart = new Date($("#reservation_dateFin").val());

    if (isNaN(dateArrivee.getTime()) || isNaN(dateDepart.getTime())) {
        // Vérifier si les dates ne sont pas valides
        $("#total").text("Total : 0");
        return;
    }

    if (dateDepart < dateArrivee) {
        alert("La date de départ ne doit pas être antérieure à la date d'arrivée");
        return;
    }

    const msPerDay = 24 * 60 * 60 * 1000; // Nombre de millisecondes par jour
    const diffInDays = Math.ceil((dateDepart - dateArrivee) / msPerDay);
    const prixParNuit = parseFloat($("#prix").text().replace("EUR", "").trim());

    const total = diffInDays * prixParNuit;
    $("#total").text("Total : " + total.toFixed(2) + " EUR");
}

$("#reservation_dateDebut, #reservation_dateFin").on("change", calculPrix);



</script>

{% endblock %}