{% extends 'base-backend.html.twig' %}

{% block title %}Reservation index{% endblock %}

{% block body %}
    <a href="{{ path('app_admin_reservation_new') }}">Create new</a>
    <h1>Gestion des réservations</h1>

    <table class="table table-index table-striped table-responsive">
        <thead>
            <tr>
                <th>Id</th>
                <th>DateDebut</th>
                <th>DateFin</th>
                <th>Nom</th>
                <th>Prenom</th>   
                <th>prix</th>
                <th>actions</th>
             
                
            </tr>
        </thead>
        <tbody>
        {% for reservation in reservations %}
            <tr>
                <td>{{ reservation.id }}</td>
                <td>{{ reservation.dateDebut ? reservation.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ reservation.dateFin ? reservation.dateFin|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ reservation.nom }}</td>
                <td>{{ reservation.prenom }}</td>
                 <td>{{ reservation.prix }}</td>
                 <td>
                    {% include 'admin_reservation/_delete_form.html.twig' %}
                    <a href="{{ path('app_admin_reservation_show', {'id': reservation.id}) }}" class="btn btn-dark"><i class="align-middle" data-feather="eye"></i></a>
                    <a href="{{ path('app_admin_reservation_edit', {'id': reservation.id}) }}" class="btn btn-success"><i class="align-middle" data-feather="edit-2"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>


{% endblock %}
